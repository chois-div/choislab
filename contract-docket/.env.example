# Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of email addresses allowed to access the workspace
CONTRACT_ACCESS_EMAILS=

# SMTP account for sending real contract links
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Public base URL used for authentication callbacks and recipient links
APP_URL=http://localhost:3000
